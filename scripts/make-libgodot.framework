if test x$2 = x; then
   echo usage is: make-libgodot.framework GODOT_DIR OUTPUT_DIR
   echo provide the base directory to where your LibGodot was built
   exit 1
fi
DIR=$1
ODIR=$2
set -e  # fail loudly if a source header is missing, rather than shipping a header-less framework
rm -rf $ODIR/libgodot.xcframework
tmp=/tmp/dir-$$
mkdir $tmp
# Godot 4.6+ generates the interface header as gdextension_interface.gen.h, and
# core/extension/libgodot.h includes it by that name -- so keep the .gen suffix.
cp $DIR/core/extension/gdextension_interface.gen.h $tmp/gdextension_interface.gen.h
cp $DIR/core/extension/libgodot.h $tmp/libgodot.h
cat > $tmp/module.modulemap << EOF
module libgodot {
    header "libgodot.h"
    export *
}
EOF

libraries=""
for f in $DIR/bin/libgodot.ios*.a
do
    libraries="$libraries -library $f -headers $tmp"
done
xcodebuild -create-xcframework $libraries -output $ODIR/libgodot.xcframework
rm -rf /tmp/dir-$$
